# Copy this file to .env and fill in your private values.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
PORT=5000
COOKIE_SECURE=true
SITE_URL=https://your-deployed-domain.example

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Admin identity. Set a password hash using: python make_admin_hash.py
ADMIN_EMAIL=sahayasathish60@gmail.com
ADMIN_PASSWORD_HASH=PASTE_GENERATED_HASH_HERE

# AI: OpenRouter is preferred; Gemini is used if OpenRouter is not configured.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=

# Resend email API. Verify your sending domain before production use.
RESEND_API_KEY=
EMAIL_FROM=SATHRYX Classes <classes@your-verified-domain.example>
